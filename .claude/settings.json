{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "Bash(npm run test*)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(npm run eval *)",
      "PowerShell(npm run test*)",
      "PowerShell(npm run typecheck *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run build *)",
      "PowerShell(npm run eval *)"
    ],
    "ask": [
      "Bash(git push *main*)",
      "PowerShell(git push *main*)",
      "Bash(eas *)",
      "Bash(npx eas *)",
      "Bash(npx eas-cli *)",
      "Bash(npx supabase *)",
      "Bash(npx vercel *)",
      "Bash(supabase *)",
      "Bash(vercel *)",
      "PowerShell(eas *)",
      "PowerShell(npx eas *)",
      "PowerShell(npx eas-cli *)",
      "PowerShell(npx supabase *)",
      "PowerShell(npx vercel *)",
      "PowerShell(supabase *)",
      "PowerShell(vercel *)"
    ],
    "deny": [
      "Bash(git clean *)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git reset --hard*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.smoke.local)",
      "Read(.env.*.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(*.credentials.json)",
      "Read(/docs/ai/live-output-*)"
    ]
  }
}
