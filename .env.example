NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
# Raw service-account credential JSON. Server-only; takes precedence over the
# file-path mechanism when both are configured.
GOOGLE_CLOUD_CREDENTIALS_JSON=
# Filesystem path only. Never place raw credential JSON in this variable.
GOOGLE_APPLICATION_CREDENTIALS=
PROCESSING_WORKER_CONCURRENCY=2
PROCESSING_WORKER_BUILD_REVISION=

# Optional developer live Canvas validation only.
# Use a developer-owned Canvas test account. This is not a shared runtime
# credential for all Stay Focused users.
CANVAS_BASE_URL=
CANVAS_PERSONAL_ACCESS_TOKEN=
CANVAS_ACCESS_TOKEN=
CANVAS_LIVE_BASE_URL=
CANVAS_LIVE_PERSONAL_ACCESS_TOKEN=

# Required by the API before per-user Canvas credentials can be stored.
# Deployment-owned base64 value that must decode to exactly 32 bytes.
CANVAS_TOKEN_ENCRYPTION_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
