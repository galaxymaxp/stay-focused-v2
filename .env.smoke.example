SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=

# Hosted durable Canvas validation. Keep the temporary-selection flag disabled
# unless the validator may briefly select and then restore a likely-current
# course when the account has no saved course selection.
CANVAS_SYNC_VALIDATION_API_BASE_URL=https://your-v2-api.example.com
CANVAS_SYNC_VALIDATION_ALLOW_TEMPORARY_SELECTION=0
CANVAS_SYNC_VALIDATION_COURSE_ID=

# Optional connection replacement for a dedicated test account. Ordinary
# validation reuses the encrypted Canvas connection already saved by the app.
CANVAS_SYNC_VALIDATION_RECONNECT=0
CANVAS_BASE_URL=
CANVAS_PERSONAL_ACCESS_TOKEN=
