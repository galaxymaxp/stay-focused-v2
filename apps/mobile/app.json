{
  "expo": {
    "name": "Stay Focused V2",
    "slug": "stay-focused-v2",
    "version": "2.0.0",
    "icon": "./assets/branding/app-icon.png",
    "runtimeVersion": "2.0.0",
    "orientation": "portrait",
    "scheme": "stayfocused",
    "ios": {
      "bundleIdentifier": "com.galaxymaxp.stayfocusedv2",
      "icon": "./assets/branding/app-icon.png"
    },
    "android": {
      "package": "com.galaxymaxp.stayfocusedv2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/orb-adaptive-foreground.png",
        "monochromeImage": "./assets/branding/orb-monochrome.png",
        "backgroundColor": "#050506"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Stay Focused to import study images for OCR.",
          "cameraPermission": "Allow Stay Focused to take study photos for OCR."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b3a9db6-3712-4ed0-8365-17d9936562dd"
      }
    },
    "owner": "galaxymaxp",
    "updates": {
      "url": "https://u.expo.dev/2b3a9db6-3712-4ed0-8365-17d9936562dd"
    }
  }
}
