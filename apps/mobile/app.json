{
  "expo": {
    "name": "Stay Focused V2",
    "slug": "stay-focused-v2",
    "version": "2.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "scheme": "stayfocused",
    "ios": {
      "bundleIdentifier": "com.galaxymaxp.stayfocusedv2"
    },
    "android": {
      "package": "com.galaxymaxp.stayfocusedv2",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Stay Focused to import study images for OCR.",
          "cameraPermission": "Allow Stay Focused to take study photos for OCR."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b3a9db6-3712-4ed0-8365-17d9936562dd"
      }
    },
    "owner": "galaxymaxp"
  }
}
