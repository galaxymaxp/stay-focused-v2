# Public mobile configuration only. Do not put service-role keys, provider
# secrets, Canvas personal access tokens, or Canvas encryption keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Local Expo development follows the current Metro LAN host automatically.
# Preview/production builds must use an explicit deployed HTTPS API origin.
# Local Expo development uses auto. EAS preview/production override this with
# the hosted Vercel API in eas.json.
EXPO_PUBLIC_API_BASE_URL=auto
# Optional when the local API is not on the default port 3000.
EXPO_PUBLIC_LOCAL_API_PORT=3000
