{
  "name": "stay-focused-v2",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "release:apk": "node scripts/publish-apk-release.mjs",
    "test:publish-apk-release": "node --test scripts/publish-apk-release.test.mjs",
    "smoke:canvas-grades:web": "node scripts/canvas-grades-web-smoke.mjs",
    "smoke:ocr-pdf:web": "node scripts/ocr-pdf-web-smoke.mjs",
    "smoke:ocr:web": "node scripts/ocr-web-smoke.mjs",
    "smoke:reviewer:web": "node scripts/reviewer-web-smoke.mjs",
    "test:canvas-grades-web-smoke": "node --test scripts/canvas-grades-web-smoke.test.mjs",
    "test:reviewer-web-smoke": "node --test scripts/reviewer-web-smoke.test.mjs",
    "validate:reviewer-canvas:r2": "node scripts/r2-canvas-live-validation.mjs",
    "validate:ocr:r3": "tsx scripts/r3-ocr-protected-validation.ts",
    "validate:processing-jobs": "tsx scripts/processing-jobs-live-validation.ts",
    "validate:canvas-sync-jobs": "tsx scripts/canvas-sync-jobs-live-validation.ts",
    "validate:canvas:r4": "tsx scripts/r4-canvas-protected-validation.ts",
    "validate:canvas:r5": "tsx scripts/r5-canvas-protected-validation.ts",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-next": "^15.5.27",
    "next": "15.5.27",
    "playwright": "^1.61.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "workflow": "4.8.13"
  },
  "overrides": {
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "postcss": "8.5.30",
    "sharp": "0.35.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@workflow/core@4.8.13": {
      "devalue": "5.9.4",
      "nanoid": "5.1.16",
      "@vercel/functions": "3.7.6"
    },
    "@workflow/nest@4.0.29": {
      "@nestjs/common": "11.1.28",
      "@nestjs/core": "11.1.28"
    }
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2"
}
